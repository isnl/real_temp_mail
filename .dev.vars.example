# Copy this file to .dev.vars for local development. Never commit real values.
ENVIRONMENT="development"
FRONTEND_DOMAIN="localhost:8787"
JWT_SECRET="replace-with-a-long-random-development-secret"
# 仅用于首次创建管理员，至少 32 个字符；初始化完成后可从 .dev.vars 删除。
ADMIN_SETUP_TOKEN="replace-with-a-separate-one-time-admin-setup-token"
