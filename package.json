{
  "name": "temp-mail-system",
  "version": "1.0.0",
  "description": "基于 Cloudflare 全家桶的临时邮箱管理系统",
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && wrangler dev",
    "build": "npm run build:frontend && npm run type-check:backend",
    "build:frontend": "npm run build --workspace temp-mail-frontend",
    "type-check:backend": "npm run build --workspace temp-mail-backend -- --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build"
  },
  "keywords": [
    "temp-email",
    "cloudflare",
    "vue3",
    "typescript",
    "workers"
  ],
  "author": "Temp Mail System",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
