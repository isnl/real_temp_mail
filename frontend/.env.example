# Every VITE_* value is shipped to the browser; never put secrets in this file.
# API calls use the current origin by default.
VITE_APP_TITLE=临时邮箱管理系统
VITE_APP_DESCRIPTION=基于Cloudflare的临时邮箱服务

# Only set this when intentionally developing the UI against a different API
# origin. Leave it empty for the unified Workers Static Assets deployment.
VITE_API_BASE_URL=
